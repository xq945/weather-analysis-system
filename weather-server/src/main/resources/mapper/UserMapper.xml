<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.weather.mapper.UserMapper">

    <!-- User 实体字段映射 -->
    <resultMap id="BaseResultMap" type="com.weather.entity.User">
        <id column="id" property="id"/>
        <result column="username" property="username"/>
        <result column="password" property="password"/>
        <result column="nickname" property="nickname"/>
        <result column="permission" property="permission"/>
        <result column="status" property="status"/>
        <result column="created_at" property="createdAt"/>
    </resultMap>

    <!-- 基础查询列 -->
    <sql id="BaseColumns">
        id, username, password, nickname, permission, status, created_at
    </sql>

    <!-- 按 ID 查询用户 -->
    <select id="findById" resultMap="BaseResultMap">
        SELECT <include refid="BaseColumns"/>
        FROM user
        WHERE id = #{id}
    </select>

    <!-- 按用户名查询用户（登录用） -->
    <select id="findByUsername" resultMap="BaseResultMap">
        SELECT <include refid="BaseColumns"/>
        FROM user
        WHERE username = #{username}
    </select>

    <!-- 查询所有用户，按 ID 升序 -->
    <select id="listAllOrderById" resultMap="BaseResultMap">
        SELECT <include refid="BaseColumns"/>
        FROM user
        ORDER BY id ASC
    </select>

    <!-- 按 ID 列表批量查询 -->
    <select id="selectBatchIds" resultMap="BaseResultMap">
        SELECT <include refid="BaseColumns"/>
        FROM user
        WHERE id IN
        <foreach collection="ids" item="id" open="(" separator="," close=")">
            #{id}
        </foreach>
    </select>

    <!-- 按用户名统计（检查用户名是否已存在） -->
    <select id="countByUsername" resultType="long">
        SELECT COUNT(*)
        FROM user
        WHERE username = #{username}
    </select>

    <!-- 新增用户，回填自增 ID -->
    <insert id="insertUser" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO user (username, password, nickname, permission, status)
        VALUES (#{username}, #{password}, #{nickname}, #{permission}, #{status})
    </insert>

    <!-- 更新用户信息（只更新非空字段） -->
    <update id="updateUser">
        UPDATE user
        <set>
            <if test="nickname != null">nickname = #{nickname},</if>
            <if test="permission != null">permission = #{permission},</if>
            <if test="status != null">status = #{status},</if>
        </set>
        WHERE id = #{id}
    </update>

</mapper>
